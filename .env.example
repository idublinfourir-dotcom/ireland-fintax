# Copy to `.env.local` and fill in. `.env*` is gitignored — never commit values.
# Same keys must also be set in the hosting provider's project env for prod.

# --- Database (MongoDB) -----------------------------------------------------
# Server-only. Used by app/lib/mongodb.ts for every read and write.
#
# Either set MONGODB_URI to a complete connection string…
MONGODB_URI=
# …or give the Atlas parts and let the app assemble it. Whichever is simpler;
# MONGODB_URI wins when both are present. The password is URI-encoded for you,
# so paste it exactly as Atlas shows it.
DB_USER=
DB_PASSWORD=
# Host only, no scheme and no trailing slash, e.g. cluster0.abcde.mongodb.net
DB_CLUSTER=
# Database name inside the cluster. Defaults to "aibn" when unset.
MONGODB_DB=

# --- Auth.js ----------------------------------------------------------------
# Signs and encrypts the session JWT. Generate with: openssl rand -base64 32
# Changing it signs everyone out. Server-only — never NEXT_PUBLIC.
AUTH_SECRET=
# Canonical origin, e.g. https://www.example.ie — set in PRODUCTION so the
# OAuth callback and the emailed confirmation links don't depend on a forwarded
# host header. Leave empty locally.
AUTH_URL=

# Comma-separated admin allow-list. An account created with one of these
# addresses gets role=admin; everyone else gets client. This is the ONLY place
# the role is decided, on every sign-in path. Case-insensitive.
ADMIN_EMAILS=

# --- Google sign-in (optional) ----------------------------------------------
# From the Google Cloud console → APIs & Services → Credentials → OAuth client.
# The authorized redirect URI is THIS APP's own callback — add one entry per
# host you sign in from:
#   http://localhost:3000/api/auth/callback/google
#   https://<prod-host>/api/auth/callback/google
# With these unset the "Continue with Google" button is not rendered.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Email (SMTP, server-side) ----------------------------------------------
# Everything this site sends goes over plain SMTP through app/lib/mailer.ts:
# the enquiry acknowledgement, the admin's reply to a client, and the signup
# confirmation link. Message layouts live in the repo (app/lib/*-email.ts), not
# in a provider dashboard, so there is nothing to configure outside these keys.
#
# With SMTP_HOST / SMTP_USER / SMTP_PASS unset, sending is a logged no-op: the
# site still works, enquiries are still stored and admin replies still land in
# the portal. Email SIGNUP is refused up front, though, because a confirmation
# link that cannot be sent leaves an account nobody can ever sign in to.
#
# Currently pointed at the AIBN Zoho mailbox (verified working on this host and
# port). Zoho wants a 12-character APP password from
# accounts.zoho.com -> Security -> App passwords, never the login password, and
# note that smtppro.zoho.com returns 554 5.7.8 Access Restricted for this
# account on both 465 and 587, so do not "fix" the host to it.
SMTP_HOST=smtp.zoho.com
# 465 = implicit TLS (default). 587 = STARTTLS.
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional. Both default to SMTP_USER. A display name is fine in MAIL_FROM, but
# the address itself must be one the SMTP account is allowed to send as, or the
# provider rejects the message.
MAIL_FROM=
MAIL_REPLY_TO=
