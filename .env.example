# Copy to `.env.local` and fill in. `.env*` is gitignored — never commit values.
# Same keys must also be set in the hosting provider's project env for prod.

# --- Database (Postgres via `pg`) -------------------------------------------
# Server-only. Used by app/lib/db.ts for the contact write, admin reads and all
# role lookups.
DATABASE_URL=

# --- Supabase Auth ----------------------------------------------------------
# NEXT_PUBLIC_* are exposed to the browser by design.
# next.config.ts derives the CSP `connect-src` allow-list from the URL below,
# so no CSP edit is needed when this changes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — MUST NOT be prefixed NEXT_PUBLIC. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Contact enquiry email (EmailJS REST API, server-side) ------------------
# The monitored inbox that receives enquiry notifications. If unset, the email
# step is skipped and only the DB row is written.
ENQUIRY_TO_EMAIL=
EmailJs_Gmail_serviceid_KEY=
EmailJs_Template_KEY=
EmailJs_PUBLIC_KEY=
EmailJs_Private_KEY=
