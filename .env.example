# Copy to `.env.local` and fill in. `.env*` is gitignored — never commit values.
# Same keys must also be set in the hosting provider's project env for prod.

# --- Database (MongoDB) -----------------------------------------------------
# Server-only. Used by app/lib/mongodb.ts for every read and write.
#
# Either set MONGODB_URI to a complete connection string…
MONGODB_URI=
# …or give the Atlas parts and let the app assemble it. Whichever is simpler;
# MONGODB_URI wins when both are present. The password is URI-encoded for you,
# so paste it exactly as Atlas shows it.
DB_USER=
DB_PASSWORD=
# Host only, no scheme and no trailing slash, e.g. cluster0.abcde.mongodb.net
DB_CLUSTER=
# Database name inside the cluster. Defaults to "aibn" when unset.
MONGODB_DB=

# --- Auth.js ----------------------------------------------------------------
# Signs and encrypts the session JWT. Generate with: openssl rand -base64 32
# Changing it signs everyone out. Server-only — never NEXT_PUBLIC.
AUTH_SECRET=
# Canonical origin, e.g. https://www.example.ie — set in PRODUCTION so the
# OAuth callback and the emailed confirmation links don't depend on a forwarded
# host header. Leave empty locally.
AUTH_URL=

# Comma-separated admin allow-list. An account created with one of these
# addresses gets role=admin; everyone else gets client. This is the ONLY place
# the role is decided, on every sign-in path. Case-insensitive.
ADMIN_EMAILS=

# --- Google sign-in (optional) ----------------------------------------------
# From the Google Cloud console → APIs & Services → Credentials → OAuth client.
# The authorized redirect URI is THIS APP's own callback — add one entry per
# host you sign in from:
#   http://localhost:3000/api/auth/callback/google
#   https://<prod-host>/api/auth/callback/google
# With these unset the "Continue with Google" button is not rendered.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Email (EmailJS REST API, server-side) ----------------------------------
# The monitored inbox that receives enquiry notifications. If unset, the email
# step is skipped and only the enquiry document is written.
ENQUIRY_TO_EMAIL=
EmailJs_Gmail_serviceid_KEY=
EmailJs_PUBLIC_KEY=
EmailJs_Private_KEY=
# Enquiry notification template. Its "To email" field must be {{to_email}}.
EmailJs_Template_KEY=
# Signup confirmation template. Needs {{to_email}} and {{verify_url}}; without
# it new accounts are created but no confirmation link is ever sent.
EmailJs_Verify_Template_KEY=
